#!/bin/bash

# Privileged half of the XPS Power widget: writes the Dell battery charging
# controls in sysfs. Runs as root via pkexec, and is only ever run from its
# installed, root-owned location (see system/install.sh). Never point pkexec
# at a copy inside the plugin checkout: that folder is writable by the
# desktop user, so anything running as that user could swap the script for
# arbitrary code that then runs as root after a legitimate auth prompt.
#
# The caller is untrusted, so every argument is checked against an allowlist
# here and the sysfs paths are fixed. Nothing else is read from the caller.
#
#   xps-power-battery-set mode <Fast|Standard|Adaptive|Custom>
#   xps-power-battery-set threshold <60|80|90|100>
#
# mode: sets charge_types on all present batteries. Fast/Standard/Adaptive
# are Dell's own uncapped/heuristic modes; Custom is the only mode that
# honors charge_control_start/end_threshold.
#
# threshold: sets the charge-stop threshold on all present batteries. 100
# flips the EC back to Fast/uncapped charging; anything below switches it to
# Custom mode so charge_control_end_threshold is honored.
#
# Start threshold is end-5, clamped to [50, 95]:
#   - The EC enforces an exact minimum 5-point gap between start and end.
#     Confirmed empirically: requesting a 0-point gap (70/70) silently
#     landed as end=75; requesting a 1-point gap (69/70) also landed as
#     end=74 (i.e. start+5). Since the gap can never be tightened below 5
#     regardless of current capacity, there's no benefit to a
#     capacity-aware start value (an earlier version of this script tried
#     that) — end-5 is already the closest the EC allows, so raising the
#     cap resumes charging immediately or after at most ~5 points of
#     natural drain.
#   - Clamped to 50 because this Dell's BIOS enforces a hard floor on
#     CustomChargeStart (see /sys/class/firmware-attributes/dell-wmi-sysman/
#     attributes/CustomChargeStart/min_value); writing below it silently
#     no-ops rather than erroring, which is what made "0" appear to do
#     nothing. Clamped to 95 because that's the BIOS max_value.
#
# Write order depends on direction, because the EC validates each write
# against whichever of the *other* value is still live at that moment:
#   - Raising the cap: write end first, then start. Writing a start above
#     the still-old (lower) end gets silently rejected, leaving start stuck
#     at its old value (observed: 70 -> 90 left start at 65 instead of 85).
#   - Lowering the cap: write start first, then end. Writing a lower end
#     while start is still above (end-5) gets silently bumped up to
#     start+5 instead of accepted (observed above).

set -euo pipefail

PATH=/usr/bin:/bin

# Fixed on purpose: not overridable from the environment or arguments.
POWER_SUPPLY=/sys/class/power_supply

usage() {
  echo "Usage: xps-power-battery-set mode <Fast|Standard|Adaptive|Custom>" >&2
  echo "       xps-power-battery-set threshold <60|80|90|100>" >&2
  exit 1
}

find_batteries() {
  shopt -s nullglob
  batteries=("$POWER_SUPPLY"/BAT*)
  (( ${#batteries[@]} > 0 )) || { echo "no battery found" >&2; exit 1; }
}

set_mode() {
  local mode=$1 bat
  find_batteries
  for bat in "${batteries[@]}"; do
    [[ -f $bat/charge_types ]] || continue
    echo "$mode" >"$bat/charge_types"
  done
}

set_threshold() {
  local pct=$1 start old_end bat

  start=$(( pct - 5 ))
  (( start < 50 )) && start=50
  (( start > 95 )) && start=95

  find_batteries
  for bat in "${batteries[@]}"; do
    [[ -f $bat/charge_control_end_threshold ]] || continue

    old_end=$(<"$bat/charge_control_end_threshold")

    if (( pct >= old_end )); then
      echo "$pct" >"$bat/charge_control_end_threshold"
      [[ -f $bat/charge_control_start_threshold ]] && echo "$start" >"$bat/charge_control_start_threshold"
    else
      [[ -f $bat/charge_control_start_threshold ]] && echo "$start" >"$bat/charge_control_start_threshold"
      echo "$pct" >"$bat/charge_control_end_threshold"
    fi

    if [[ -f $bat/charge_types ]]; then
      if [[ $pct == 100 ]]; then
        echo Fast >"$bat/charge_types"
      else
        echo Custom >"$bat/charge_types"
      fi
    fi
  done
}

(( $# == 2 )) || usage

case $1 in
  mode)
    [[ $2 =~ ^(Fast|Standard|Adaptive|Custom)$ ]] || usage
    set_mode "$2"
    ;;
  threshold)
    [[ $2 =~ ^(60|80|90|100)$ ]] || usage
    set_threshold "$2"
    ;;
  *)
    usage
    ;;
esac
